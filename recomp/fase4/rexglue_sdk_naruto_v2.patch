diff --git a/src/core/threading_posix.cpp b/src/core/threading_posix.cpp
index e10e30b..27e2d92 100644
--- a/src/core/threading_posix.cpp
+++ b/src/core/threading_posix.cpp
@@ -1311,13 +1311,20 @@ void* PosixCondition<Thread>::ThreadStartRoutine(void* parameter) {
   current_thread_condition_ = &thread->handle_;
   {
     std::unique_lock<std::mutex> lock(thread->handle_.state_mutex_);
+    // FIX(lost-wakeup): suspend_count_ must be set BEFORE the state change is
+    // published. Otherwise a creator whose WaitStarted() returns in the window
+    // between the two critical sections calls Resume(), observes
+    // suspend_count_ == 0, does nothing - and this thread then sets
+    // suspend_count_ = 1 and waits forever.
+    if (create_suspended) {
+      thread->handle_.suspend_count_ = 1;
+    }
     thread->handle_.state_ = create_suspended ? State::kSuspended : State::kRunning;
     thread->handle_.state_signal_.notify_all();
   }
 
   if (create_suspended) {
     std::unique_lock<std::mutex> lock(thread->handle_.state_mutex_);
-    thread->handle_.suspend_count_ = 1;
     thread->handle_.state_signal_.wait(lock,
                                        [thread] { return thread->handle_.suspend_count_ == 0; });
   }
