+void SDLAudioDriver::AccumulateInputDiagnostics(const float* input) {
+  if (!REXCVAR_GET(audio_silence_diagnostics)) {
+    return;
+  }
+
+  bool frame_has_signal = false;
+  for (size_t channel = 0; channel < frame_channels_; ++channel) {
+    bool channel_has_signal = false;
+    for (size_t sample_index = 0; sample_index < channel_samples_; ++sample_index) {
+      const float sample = rex::byte_swap(input[channel * channel_samples_ + sample_index]);
+      if (!std::isfinite(sample)) {
+        continue;
+      }
+      const float magnitude = std::abs(sample);
+      diagnostic_channel_peaks_[channel] = std::max(diagnostic_channel_peaks_[channel], magnitude);
+      channel_has_signal = channel_has_signal || magnitude > 1.0e-6f;
+    }
+    if (channel_has_signal) {
+      ++diagnostic_active_channel_frames_[channel];
+      frame_has_signal = true;
+    }
+  }
+
+  ++diagnostic_frame_count_;
+  if (frame_has_signal) {
+    diagnostic_current_silent_run_ = 0;
+  } else {
+    ++diagnostic_silent_frame_count_;
+    ++diagnostic_current_silent_run_;
+    diagnostic_max_silent_run_ =
+        std::max(diagnostic_max_silent_run_, diagnostic_current_silent_run_);
+  }
+}
+
+void SDLAudioDriver::LogInputDiagnosticsSummary() {
+  if (!REXCVAR_GET(audio_silence_diagnostics) || !diagnostic_frame_count_) {
+    return;
+  }
+
+  constexpr double kFrameDurationMs =
+      1000.0 * static_cast<double>(channel_samples_) / frame_frequency_;
+  REXAPU_INFO(
+      "NARUTO_AUDIO_SILENCE_SUMMARY frames={} silent_frames={} "
+      "silent_percent={:.2f} max_silent_frames={} max_silent_ms={:.2f} "
+      "active_frames=[{},{},{},{},{},{}] "
+      "peak=[{:.3f},{:.3f},{:.3f},{:.3f},{:.3f},{:.3f}] "
+      "order=FL,FR,FC,LFE,BL,BR",
+      diagnostic_frame_count_, diagnostic_silent_frame_count_,
+      100.0 * static_cast<double>(diagnostic_silent_frame_count_) / diagnostic_frame_count_,
+      diagnostic_max_silent_run_, diagnostic_max_silent_run_ * kFrameDurationMs,
+      diagnostic_active_channel_frames_[0], diagnostic_active_channel_frames_[1],
+      diagnostic_active_channel_frames_[2], diagnostic_active_channel_frames_[3],
+      diagnostic_active_channel_frames_[4], diagnostic_active_channel_frames_[5],
+      diagnostic_channel_peaks_[0], diagnostic_channel_peaks_[1], diagnostic_channel_peaks_[2],
+      diagnostic_channel_peaks_[3], diagnostic_channel_peaks_[4], diagnostic_channel_peaks_[5]);
+}
