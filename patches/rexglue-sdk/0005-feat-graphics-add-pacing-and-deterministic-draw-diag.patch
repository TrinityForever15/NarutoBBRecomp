   return true;
 }
 
+bool CommandProcessor::TraceDrawShouldSkip(uint64_t draw_index) const {
+  const int64_t limit = REXCVAR_GET(trace_draw_limit);
+  if (limit >= 0 && draw_index >= uint64_t(limit)) {
+    return true;
+  }
+  const int64_t skip_begin = REXCVAR_GET(trace_draw_skip_begin);
+  const int64_t skip_end = REXCVAR_GET(trace_draw_skip_end);
+  if (skip_begin >= 0 && skip_end > skip_begin && draw_index >= uint64_t(skip_begin) &&
+      draw_index < uint64_t(skip_end)) {
+    return true;
+  }
+  return false;
+}
+
+void CommandProcessor::TraceDrawLogDiagnostics(uint64_t draw_index, uint32_t prim_type,
+                                               uint32_t num_indices, bool is_indexed,
+                                               bool skipped) {
+  const bool log_all = REXCVAR_GET(trace_draw_log_all);
+  const bool log_state = REXCVAR_GET(trace_draw_log_state) == int64_t(draw_index);
+  if (!log_all && !log_state) {
+    return;
+  }
+  const RegisterFile& regs = *register_file_;
+  const uint32_t edram_mode = uint32_t(regs.Get<reg::RB_MODECONTROL>().edram_mode);
+  const uint64_t vs_hash = active_vertex_shader_ ? active_vertex_shader_->ucode_data_hash() : 0;
+  const uint64_t ps_hash = active_pixel_shader_ ? active_pixel_shader_->ucode_data_hash() : 0;
+  REXGPU_INFO(
+      "TRACE_DRAW idx={} {} prim={} indices={} indexed={} edram_mode={} VS={:016X} PS={:016X}",
+      draw_index, skipped ? "SKIPPED" : "issued", prim_type, num_indices, uint32_t(is_indexed),
+      edram_mode, vs_hash, ps_hash);
+  if (log_state) {
+    REXGPU_INFO(
+        "TRACE_DRAW_STATE idx={} RB_SURFACE_INFO={:08X} RB_MODECONTROL={:08X} "
+        "RB_COLOR_INFO={:08X}/{:08X}/{:08X}/{:08X} RB_DEPTH_INFO={:08X} "
+        "RB_COLOR_MASK={:08X} RB_COLORCONTROL={:08X} RB_DEPTHCONTROL={:08X} "
+        "RB_STENCILREFMASK={:08X} RB_STENCILREFMASK_BF={:08X} "
+        "RB_BLENDCONTROL={:08X}/{:08X}/{:08X}/{:08X}",
+        draw_index, regs[XE_GPU_REG_RB_SURFACE_INFO], regs[XE_GPU_REG_RB_MODECONTROL],
+        regs[XE_GPU_REG_RB_COLOR_INFO], regs[XE_GPU_REG_RB_COLOR1_INFO],
+        regs[XE_GPU_REG_RB_COLOR2_INFO], regs[XE_GPU_REG_RB_COLOR3_INFO],
+        regs[XE_GPU_REG_RB_DEPTH_INFO], regs[XE_GPU_REG_RB_COLOR_MASK],
+        regs[XE_GPU_REG_RB_COLORCONTROL], regs[XE_GPU_REG_RB_DEPTHCONTROL],
+        regs[XE_GPU_REG_RB_STENCILREFMASK], regs[XE_GPU_REG_RB_STENCILREFMASK_BF],
+        regs[XE_GPU_REG_RB_BLENDCONTROL0], regs[XE_GPU_REG_RB_BLENDCONTROL1],
+        regs[XE_GPU_REG_RB_BLENDCONTROL2], regs[XE_GPU_REG_RB_BLENDCONTROL3]);
+    REXGPU_INFO(
+        "TRACE_DRAW_COPY idx={} RB_COPY_CONTROL={:08X} RB_COPY_DEST_BASE={:08X} "
+        "RB_COPY_DEST_PITCH={:08X} RB_COPY_DEST_INFO={:08X}",
+        draw_index, regs[XE_GPU_REG_RB_COPY_CONTROL], regs[XE_GPU_REG_RB_COPY_DEST_BASE],
+        regs[XE_GPU_REG_RB_COPY_DEST_PITCH], regs[XE_GPU_REG_RB_COPY_DEST_INFO]);
+    REXGPU_INFO(
+        "TRACE_DRAW_SCISSOR idx={} WIN_SCISSOR_TL={:08X} WIN_SCISSOR_BR={:08X} "
+        "SCREEN_SCISSOR_TL={:08X} SCREEN_SCISSOR_BR={:08X} WINDOW_OFFSET={:08X} "
+        "CLIP_CNTL={:08X} VTE_CNTL={:08X} SU_SC_MODE_CNTL={:08X} "
+        "VPORT_YSCALE={:08X} VPORT_YOFFSET={:08X}",
+        draw_index, regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_TL],
+        regs[XE_GPU_REG_PA_SC_WINDOW_SCISSOR_BR], regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL],
+        regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR], regs[XE_GPU_REG_PA_SC_WINDOW_OFFSET],
+        regs[XE_GPU_REG_PA_CL_CLIP_CNTL], regs[XE_GPU_REG_PA_CL_VTE_CNTL],
+        regs[XE_GPU_REG_PA_SU_SC_MODE_CNTL], regs[XE_GPU_REG_PA_CL_VPORT_YSCALE],
+        regs[XE_GPU_REG_PA_CL_VPORT_YOFFSET]);
+  }
+}
