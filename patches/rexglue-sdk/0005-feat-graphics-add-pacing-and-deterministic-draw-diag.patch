+// --- Trace draw bisection (cutscene black-frame diagnostics) ---
+// All indices refer to the deterministic per-playback draw counter logged as
+// TRACE_DRAW. Defaults keep everything disabled (zero impact on the game).
+REXCVAR_DEFINE_INT64(trace_draw_limit, -1, "GPU",
+                     "Trace bisection: drop every draw/copy with index >= this value. "
+                     "-1 disables.");
+REXCVAR_DEFINE_INT64(trace_draw_skip_begin, -1, "GPU",
+                     "Trace bisection: first draw index of the skipped range "
+                     "[begin, end). -1 disables.");
+REXCVAR_DEFINE_INT64(trace_draw_skip_end, -1, "GPU",
+                     "Trace bisection: end (exclusive) of the skipped draw range.");
+REXCVAR_DEFINE_BOOL(trace_draw_log_all, false, "GPU",
+                    "Trace bisection: log one TRACE_DRAW line per draw/copy with "
+                    "index, shader hashes and EDRAM mode.");
+REXCVAR_DEFINE_INT64(trace_draw_log_state, -1, "GPU",
+                     "Trace bisection: dump full render-target/blend/depth/copy "
+                     "register state for the draw with this index. -1 disables.");
+
 REXCVAR_DEFINE_BOOL(async_shader_compilation, true, "GPU",
                     "Compile shaders and create pipelines asynchronously in background "
                     "threads. This reduces stutter but may cause brief visual artifacts while "
@@ -1096,6 +1119,105 @@ bool CommandProcessor::ExecutePacketType3_XE_SWAP(memory::RingBuffer* reader, ui
   uint32_t frontbuffer_height = reader->ReadAndSwap<uint32_t>();
   reader->AdvanceRead((count - 4) * sizeof(uint32_t));
 
+  const bool naruto_swap_has_new_frame = draw_issued_since_swap_;
+  draw_issued_since_swap_ = false;
+
+  const uint64_t naruto_tick_frequency = rex::chrono::Clock::QueryHostTickFrequency();
+  uint64_t naruto_now = rex::chrono::Clock::QueryHostTickCount();
+
+  // Lightweight transition diagnostic: this records only large gaps, not
+  // every frame. If a visible black interval has no matching entry, the game
+  // is still submitting frames and the issue is in their contents/presentation
+  // rather than a stalled producer.
+  static uint64_t naruto_previous_swap_tick = 0;
+  if (naruto_previous_swap_tick) {
+    const uint64_t gap_ticks = naruto_now - naruto_previous_swap_tick;
+    if (gap_ticks > naruto_tick_frequency / 10) {
+      REXGPU_WARN("NARUTO_SWAP_GAP ms={:.1f} frontbuffer={:08X} size={}x{}",
+                  double(gap_ticks) * 1000.0 / double(naruto_tick_frequency),
+                  frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
+    }
+  }
+  naruto_previous_swap_tick = naruto_now;
+
+  // The game submits swaps in long/short pairs even though their average is
+  // 60 Hz. Detect gameplay (rather than the intentionally 30 FPS intro) and
+  // drain the already asynchronous GPU ring at a uniform 60 Hz. Two frames of
+  // initial headroom absorb the normal producer jitter without changing game
+  // simulation timing.
+  static uint64_t naruto_rate_window_start = naruto_now;
+  static uint64_t naruto_rate_window_swaps = 0;
+  static uint64_t naruto_rate_window_rendered_swaps = 0;
+  static bool naruto_pacing_enabled = false;
+  static int naruto_last_rate_classification = -1;
+  static uint64_t naruto_next_present_tick = 0;
+  ++naruto_rate_window_swaps;
+  if (naruto_swap_has_new_frame) {
+    ++naruto_rate_window_rendered_swaps;
+  }
+  if (naruto_now - naruto_rate_window_start >= naruto_tick_frequency) {
+    const double elapsed_ticks = double(naruto_now - naruto_rate_window_start);
+    const double incoming_fps =
+        double(naruto_rate_window_swaps) * double(naruto_tick_frequency) /
+        elapsed_ticks;
+    const double rendered_fps =
+        double(naruto_rate_window_rendered_swaps) *
+        double(naruto_tick_frequency) / elapsed_ticks;
+    // Naruto often swaps twice per rendered cutscene frame. Only pace when the
+    // draw-bearing swaps themselves are running at 60 FPS; otherwise sleeping
+    // the GPU command thread can expose an intermediate black post-effect.
+    const bool should_pace = incoming_fps >= 50.0 && rendered_fps >= 50.0;
+    const bool was_pacing = naruto_pacing_enabled;
+    const int rate_classification = should_pace ? 1 : 0;
+    if (rate_classification != naruto_last_rate_classification) {
+      REXGPU_INFO("NARUTO_PACER {} incoming_fps={:.2f} rendered_fps={:.2f}",
+                  should_pace ? "enabled" : "bypassed", incoming_fps,
+                  rendered_fps);
+      naruto_last_rate_classification = rate_classification;
+    }
+    naruto_pacing_enabled = should_pace;
+    if (naruto_pacing_enabled && !was_pacing) {
+      const uint64_t interval_ticks =
+          std::max(uint64_t(1),
+                   uint64_t(double(naruto_tick_frequency) / 61.5));
+      naruto_next_present_tick = naruto_now + interval_ticks * 2;
+    } else if (!naruto_pacing_enabled) {
+      naruto_next_present_tick = 0;
+    }
+    naruto_rate_window_start = naruto_now;
+    naruto_rate_window_swaps = 0;
+    naruto_rate_window_rendered_swaps = 0;
+  }
+
+  if (REXCVAR_GET(naruto_stable_60fps_pacing) && naruto_pacing_enabled) {
+    const uint64_t interval_ticks =
+        // The wait plus command submission adds roughly 0.4 ms on this
+        // runtime. A 61.5 Hz internal target compensates that cost and yields
+        // an observed cadence close to 60 Hz without changing guest time.
+        std::max(uint64_t(1),
+                 uint64_t(double(naruto_tick_frequency) / 61.5));
+    // If the producer has genuinely stopped for more than the buffered span,
+    // present the newest frame immediately and start a fresh buffer. Never
+    // replay late frames in a burst.
+    if (naruto_now > naruto_next_present_tick + interval_ticks * 2) {
+      naruto_next_present_tick = naruto_now;
+    }
+    while (naruto_now < naruto_next_present_tick) {
+      const uint64_t remaining_ticks = naruto_next_present_tick - naruto_now;
+      const uint64_t remaining_us =
+          remaining_ticks * 1000000 / naruto_tick_frequency;
+      if (remaining_us > 1500) {
+        rex::thread::Sleep(std::chrono::microseconds(remaining_us - 500));
+      } else {
+        rex::thread::MaybeYield();
+      }
+      naruto_now = rex::chrono::Clock::QueryHostTickCount();
+    }
+    naruto_next_present_tick =
+        std::max(naruto_next_present_tick + interval_ticks,
+                 naruto_now + interval_ticks / 4);
+  }
+
   IssueSwap(frontbuffer_ptr, frontbuffer_width, frontbuffer_height);
 
   ++counter_;
