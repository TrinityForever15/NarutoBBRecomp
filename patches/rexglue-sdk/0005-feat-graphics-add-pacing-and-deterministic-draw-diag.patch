+      // Trace bisection: the counter must advance for every candidate draw so
+      // indices stay stable across replays regardless of what is skipped.
+      const uint64_t trace_draw_index = trace_draw_index_++;
+      const bool trace_draw_skipped = TraceDrawShouldSkip(trace_draw_index);
+      TraceDrawLogDiagnostics(trace_draw_index, uint32_t(vgt_draw_initiator.prim_type),
+                              vgt_draw_initiator.num_indices, is_indexed, trace_draw_skipped);
+      if (trace_draw_skipped) {
+        return true;
+      }
+      draw_issued_since_swap_ = true;
       draw_succeeded = IssueDraw(vgt_draw_initiator.prim_type, vgt_draw_initiator.num_indices,
                                  is_indexed ? &index_buffer_info : nullptr, major_mode_explicit);
       if (!draw_succeeded) {
