+void LogInputChannelLevels(const float* input, size_t channel_sample_count) {
+  static std::atomic<uint64_t> last_log_tick{0};
+  const uint64_t now_tick = rex::chrono::Clock::QueryHostTickCount();
+  const uint64_t tick_frequency = rex::chrono::Clock::QueryHostTickFrequency();
+  uint64_t previous_tick = last_log_tick.load(std::memory_order_relaxed);
+  if (previous_tick && now_tick - previous_tick < tick_frequency) {
+    return;
+  }
+  if (!last_log_tick.compare_exchange_strong(previous_tick, now_tick, std::memory_order_relaxed)) {
+    return;
+  }
+
+  std::array<float, 6> peaks{};
+  std::array<double, 6> square_sums{};
+  for (size_t channel = 0; channel < 6; ++channel) {
+    for (size_t sample_index = 0; sample_index < channel_sample_count; ++sample_index) {
+      const float sample = rex::byte_swap(input[channel * channel_sample_count + sample_index]);
+      if (!std::isfinite(sample)) {
+        continue;
+      }
+      peaks[channel] = std::max(peaks[channel], std::abs(sample));
+      square_sums[channel] += static_cast<double>(sample) * sample;
+    }
+  }
+
+  std::array<float, 6> rms{};
+  for (size_t channel = 0; channel < 6; ++channel) {
+    rms[channel] = static_cast<float>(std::sqrt(square_sums[channel] / channel_sample_count));
+  }
+  REXAPU_INFO(
+      "NARUTO_AUDIO_CHANNELS "
+      "rms=[{:.3f},{:.3f},{:.3f},{:.3f},{:.3f},{:.3f}] "
+      "peak=[{:.3f},{:.3f},{:.3f},{:.3f},{:.3f},{:.3f}] "
+      "order=FL,FR,FC,LFE,BL,BR",
+      rms[0], rms[1], rms[2], rms[3], rms[4], rms[5], peaks[0], peaks[1], peaks[2], peaks[3],
+      peaks[4], peaks[5]);
+}
+
