+inline void sequential_6_BE_to_interleaved_2_front_LE(float* output, const float* input,
+                                                      size_t ch_sample_count) {
   assert_true(ch_sample_count % 4 == 0);
 
   const __m128i byte_swap_shuffle =
@@ -90,19 +90,50 @@ inline void sequential_6_BE_to_interleaved_2_front_LE(
     __m128 fl = _mm_loadu_ps(&input[0 * ch_sample_count + sample]);
     __m128 fr = _mm_loadu_ps(&input[1 * ch_sample_count + sample]);
     __m128 fc = _mm_loadu_ps(&input[2 * ch_sample_count + sample]);
-    fl = _mm_castsi128_ps(
-        _mm_shuffle_epi8(_mm_castps_si128(fl), byte_swap_shuffle));
-    fr = _mm_castsi128_ps(
-        _mm_shuffle_epi8(_mm_castps_si128(fr), byte_swap_shuffle));
-    fc = _mm_castsi128_ps(
-        _mm_shuffle_epi8(_mm_castps_si128(fc), byte_swap_shuffle));
+    fl = _mm_castsi128_ps(_mm_shuffle_epi8(_mm_castps_si128(fl), byte_swap_shuffle));
+    fr = _mm_castsi128_ps(_mm_shuffle_epi8(_mm_castps_si128(fr), byte_swap_shuffle));
+    fc = _mm_castsi128_ps(_mm_shuffle_epi8(_mm_castps_si128(fc), byte_swap_shuffle));
 
     const __m128 center = _mm_mul_ps(fc, center_gain);
     const __m128 left = _mm_mul_ps(_mm_add_ps(fl, center), normalize);
     const __m128 right = _mm_mul_ps(_mm_add_ps(fr, center), normalize);
     _mm_storeu_ps(&output[sample * 2], _mm_unpacklo_ps(left, right));
-    _mm_storeu_ps(&output[(sample + 2) * 2],
-                  _mm_unpackhi_ps(left, right));
+    _mm_storeu_ps(&output[(sample + 2) * 2], _mm_unpackhi_ps(left, right));
+  }
+}
+
+// ITU-style stereo fold-down without LFE. Keep the total coefficient sum at
+// one for full-scale correlated input, while giving center and surround equal
+// -3 dB weighting before normalization. Compared with the legacy mix this
+// raises center intelligibility and reduces surround masking.
+inline void sequential_6_BE_to_interleaved_2_balanced_LE(float* output, const float* input,
+                                                         size_t ch_sample_count) {
+  assert_true(ch_sample_count % 4 == 0);
+
+  const __m128i byte_swap_shuffle =
+      _mm_set_epi8(12, 13, 14, 15, 8, 9, 10, 11, 4, 5, 6, 7, 0, 1, 2, 3);
+  const __m128 minus_3db = _mm_set1_ps(0.7071067812f);
+  const __m128 normalize = _mm_set1_ps(0.4142135624f);
+
+  for (size_t sample = 0; sample < ch_sample_count; sample += 4) {
+    __m128 fl = _mm_loadu_ps(&input[0 * ch_sample_count + sample]);
+    __m128 fr = _mm_loadu_ps(&input[1 * ch_sample_count + sample]);
+    __m128 fc = _mm_loadu_ps(&input[2 * ch_sample_count + sample]);
+    __m128 bl = _mm_loadu_ps(&input[4 * ch_sample_count + sample]);
+    __m128 br = _mm_loadu_ps(&input[5 * ch_sample_count + sample]);
+    fl = _mm_castsi128_ps(_mm_shuffle_epi8(_mm_castps_si128(fl), byte_swap_shuffle));
+    fr = _mm_castsi128_ps(_mm_shuffle_epi8(_mm_castps_si128(fr), byte_swap_shuffle));
+    fc = _mm_castsi128_ps(_mm_shuffle_epi8(_mm_castps_si128(fc), byte_swap_shuffle));
+    bl = _mm_castsi128_ps(_mm_shuffle_epi8(_mm_castps_si128(bl), byte_swap_shuffle));
+    br = _mm_castsi128_ps(_mm_shuffle_epi8(_mm_castps_si128(br), byte_swap_shuffle));
+
+    const __m128 center = _mm_mul_ps(fc, minus_3db);
+    const __m128 left =
+        _mm_mul_ps(_mm_add_ps(fl, _mm_add_ps(center, _mm_mul_ps(bl, minus_3db))), normalize);
+    const __m128 right =
+        _mm_mul_ps(_mm_add_ps(fr, _mm_add_ps(center, _mm_mul_ps(br, minus_3db))), normalize);
+    _mm_storeu_ps(&output[sample * 2], _mm_unpacklo_ps(left, right));
+    _mm_storeu_ps(&output[(sample + 2) * 2], _mm_unpackhi_ps(left, right));
   }
 }
 #else
@@ -130,8 +161,8 @@ inline void sequential_6_BE_to_interleaved_2_LE(float* output, const float* inpu
     output[sample * 2 + 1] = (fr + br + center_halved) * (1.0f / 2.5f);
   }
 }
-inline void sequential_6_BE_to_interleaved_2_front_LE(
-    float* output, const float* input, size_t ch_sample_count) {
+inline void sequential_6_BE_to_interleaved_2_front_LE(float* output, const float* input,
+                                                      size_t ch_sample_count) {
   constexpr float center_gain = 0.7071067812f;
   constexpr float normalize = 0.5857864376f;
   for (size_t sample = 0; sample < ch_sample_count; sample++) {
@@ -142,6 +173,20 @@ inline void sequential_6_BE_to_interleaved_2_front_LE(
     output[sample * 2 + 1] = (fr + fc * center_gain) * normalize;
   }
 }
+inline void sequential_6_BE_to_interleaved_2_balanced_LE(float* output, const float* input,
+                                                         size_t ch_sample_count) {
+  constexpr float minus_3db = 0.7071067812f;
+  constexpr float normalize = 0.4142135624f;
+  for (size_t sample = 0; sample < ch_sample_count; sample++) {
+    const float fl = rex::byte_swap(input[0 * ch_sample_count + sample]);
+    const float fr = rex::byte_swap(input[1 * ch_sample_count + sample]);
+    const float fc = rex::byte_swap(input[2 * ch_sample_count + sample]);
+    const float bl = rex::byte_swap(input[4 * ch_sample_count + sample]);
+    const float br = rex::byte_swap(input[5 * ch_sample_count + sample]);
+    output[sample * 2] = (fl + (fc + bl) * minus_3db) * normalize;
+    output[sample * 2 + 1] = (fr + (fc + br) * minus_3db) * normalize;
+  }
+}
 #endif
 
 }  // namespace rex::audio::conversion
