diff --git a/include/rex/audio/conversion.h b/include/rex/audio/conversion.h
index 5c8063b..e393496 100644
--- a/include/rex/audio/conversion.h
+++ b/include/rex/audio/conversion.h
@@ -77,8 +77,8 @@ inline void sequential_6_BE_to_interleaved_2_LE(float* output, const float* inpu
 // Some Xbox 360 titles leave content in the surround buses that isn't meant
