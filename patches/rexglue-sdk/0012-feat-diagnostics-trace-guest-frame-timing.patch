diff --git a/src/system/guest_timing.cpp b/src/system/guest_timing.cpp
new file mode 100644
index 0000000..6963917
--- /dev/null
+++ b/src/system/guest_timing.cpp
@@ -0,0 +1,292 @@
+#include <rex/diagnostics/guest_timing.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+
+#include <rex/chrono/clock.h>
+#include <rex/platform.h>
+#include <rex/system/xthread.h>
+
+#if REX_PLATFORM_WIN32
+#include <Windows.h>
+#else
+#include <time.h>
+#endif
+
+namespace rex::diagnostics {
+namespace {
+
+using HostClock = std::chrono::steady_clock;
+
+uint64_t QueryCurrentThreadCpuTimeNs();
+
+struct TimingState {
+  bool active = false;
+  uint64_t sequence = 0;
+  uint32_t scope_tag = 0;
+  uint32_t thread_id = 0;
+  HostClock::time_point start{};
+  uint64_t start_cpu_ns = 0;
+  uint64_t begin_vblank_count = 0;
+
+  uint64_t blocked_ns = 0;
+  std::array<uint64_t, kGuestWaitKindCount> wait_ns{};
+  std::array<uint32_t, kGuestWaitKindCount> wait_calls{};
+  uint64_t longest_wait_ns = 0;
+  uint32_t longest_wait_object = 0;
+  uint32_t longest_wait_object_type = 0;
+  GuestWaitKind longest_wait_kind = GuestWaitKind::kObject;
+  uint32_t vd_swap_calls = 0;
+  uint32_t timebase_reads = 0;
+  std::array<GuestTimeSourceSite, kMaxGuestTimeSourceSites>
+      time_source_sites{};
+  size_t time_source_site_count = 0;
+
+  void Reset(uint64_t new_sequence, uint32_t new_scope_tag,
+             uint32_t new_thread_id, uint64_t vblank_count) {
+    *this = {};
+    active = true;
+    sequence = new_sequence;
+    scope_tag = new_scope_tag;
+    thread_id = new_thread_id;
+    start = HostClock::now();
+    start_cpu_ns = QueryCurrentThreadCpuTimeNs();
+    begin_vblank_count = vblank_count;
+  }
+};
+
+std::atomic<bool> g_enabled{false};
+std::atomic<uint32_t> g_frame_thread_id{0};
+std::atomic<uint64_t> g_vblank_count{0};
+TimingState g_frame_state;
+thread_local TimingState g_scope_state;
+
+uint64_t QueryCurrentThreadCpuTimeNs() {
+#if REX_PLATFORM_WIN32
+  FILETIME creation_time;
+  FILETIME exit_time;
+  FILETIME kernel_time;
+  FILETIME user_time;
+  if (!GetThreadTimes(GetCurrentThread(), &creation_time, &exit_time,
+                      &kernel_time, &user_time)) {
+    return 0;
+  }
+
+  ULARGE_INTEGER kernel_ticks;
+  kernel_ticks.LowPart = kernel_time.dwLowDateTime;
+  kernel_ticks.HighPart = kernel_time.dwHighDateTime;
+  ULARGE_INTEGER user_ticks;
+  user_ticks.LowPart = user_time.dwLowDateTime;
+  user_ticks.HighPart = user_time.dwHighDateTime;
+  return (kernel_ticks.QuadPart + user_ticks.QuadPart) * 100;
+#else
+  timespec value;
+  if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &value) != 0) {
+    return 0;
+  }
+  return static_cast<uint64_t>(value.tv_sec) * 1'000'000'000ull +
+         static_cast<uint64_t>(value.tv_nsec);
+#endif
+}
+
+uint32_t CurrentGuestThreadId() {
+  auto* thread = system::XThread::GetCurrentThread();
+  return thread ? thread->thread_id() : 0;
+}
+
+void AddWait(TimingState& state, GuestWaitKind kind, uint32_t object_type,
+             uint32_t guest_object, uint64_t duration_ns) {
+  if (!state.active) {
+    return;
+  }
+  const size_t index = static_cast<size_t>(kind);
+  if (index >= kGuestWaitKindCount) {
+    return;
+  }
+  state.blocked_ns += duration_ns;
+  state.wait_ns[index] += duration_ns;
+  ++state.wait_calls[index];
+  if (duration_ns > state.longest_wait_ns) {
+    state.longest_wait_ns = duration_ns;
+    state.longest_wait_object = guest_object;
+    state.longest_wait_object_type = object_type;
+    state.longest_wait_kind = kind;
+  }
+}
+
+void AddTimebaseRead(TimingState& state, uint32_t guest_pc) {
+  if (!state.active) {
+    return;
+  }
+  ++state.timebase_reads;
+  for (size_t i = 0; i < state.time_source_site_count; ++i) {
+    if (state.time_source_sites[i].guest_pc == guest_pc) {
+      ++state.time_source_sites[i].calls;
+      return;
+    }
+  }
+  if (state.time_source_site_count < state.time_source_sites.size()) {
+    auto& site = state.time_source_sites[state.time_source_site_count++];
+    site.guest_pc = guest_pc;
+    site.calls = 1;
+  }
+}
+
+GuestTimingSample FinishState(TimingState& state) {
+  GuestTimingSample sample;
+  if (!state.active) {
+    return sample;
+  }
+
+  const auto now = HostClock::now();
+  sample.valid = true;
+  sample.sequence = state.sequence;
+  sample.scope_tag = state.scope_tag;
+  sample.thread_id = state.thread_id;
+  sample.wall_ns = static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(now - state.start)
+          .count());
+  const uint64_t end_cpu_ns = QueryCurrentThreadCpuTimeNs();
+  sample.cpu_ns =
+      end_cpu_ns >= state.start_cpu_ns ? end_cpu_ns - state.start_cpu_ns : 0;
+  sample.blocked_ns = std::min(state.blocked_ns, sample.wall_ns);
+  sample.wait_ns = state.wait_ns;
+  sample.wait_calls = state.wait_calls;
+  sample.longest_wait_ns = state.longest_wait_ns;
+  sample.longest_wait_object = state.longest_wait_object;
+  sample.longest_wait_object_type = state.longest_wait_object_type;
+  sample.longest_wait_kind = state.longest_wait_kind;
+  sample.vblank_pulses = static_cast<uint32_t>(
+      g_vblank_count.load(std::memory_order_relaxed) -
+      state.begin_vblank_count);
+  sample.vd_swap_calls = state.vd_swap_calls;
+  sample.timebase_reads = state.timebase_reads;
+  sample.time_source_sites = state.time_source_sites;
+  sample.time_source_site_count = state.time_source_site_count;
+  state.active = false;
+  return sample;
+}
+
+bool IsFrameThread(uint32_t thread_id) {
+  return thread_id != 0 &&
+         thread_id == g_frame_thread_id.load(std::memory_order_relaxed);
+}
+
+}  // namespace
+
+void SetGuestTimingTraceEnabled(bool enabled) {
+  g_enabled.store(enabled, std::memory_order_release);
+  if (!enabled) {
+    g_frame_state.active = false;
+    g_frame_thread_id.store(0, std::memory_order_relaxed);
+  } else {
+    g_frame_state = {};
+    g_frame_thread_id.store(0, std::memory_order_relaxed);
+  }
+}
+
+bool GuestTimingTraceEnabled() {
+  return g_enabled.load(std::memory_order_acquire);
+}
+
+void BeginGuestFrameTiming(uint64_t sequence) {
+  if (!GuestTimingTraceEnabled()) {
+    return;
+  }
+  const uint32_t thread_id = CurrentGuestThreadId();
+  if (!thread_id) {
+    return;
+  }
+  uint32_t expected = 0;
+  g_frame_thread_id.compare_exchange_strong(
+      expected, thread_id, std::memory_order_relaxed);
+  if (!IsFrameThread(thread_id)) {
+    return;
+  }
+  g_frame_state.Reset(sequence, 0, thread_id,
+                      g_vblank_count.load(std::memory_order_relaxed));
+}
+
+GuestTimingSample EndGuestFrameTiming() {
+  if (!GuestTimingTraceEnabled()) {
+    return {};
+  }
+  const uint32_t thread_id = CurrentGuestThreadId();
+  if (!IsFrameThread(thread_id) || g_frame_state.thread_id != thread_id) {
+    return {};
+  }
+  return FinishState(g_frame_state);
+}
+
+void BeginGuestTimingScope(uint32_t scope_tag) {
+  if (!GuestTimingTraceEnabled()) {
+    return;
+  }
+  const uint32_t thread_id = CurrentGuestThreadId();
+  if (!thread_id || g_scope_state.active) {
+    return;
+  }
+  g_scope_state.Reset(0, scope_tag, thread_id,
+                      g_vblank_count.load(std::memory_order_relaxed));
+}
+
+GuestTimingSample EndGuestTimingScope(uint32_t scope_tag) {
+  if (!g_scope_state.active || g_scope_state.scope_tag != scope_tag) {
+    return {};
+  }
+  return FinishState(g_scope_state);
+}
+
+void RecordGuestWait(GuestWaitKind kind, uint32_t object_type,
+                     uint32_t guest_object, uint64_t duration_ns) {
+  if (!GuestTimingTraceEnabled()) {
+    return;
+  }
+  const uint32_t thread_id = CurrentGuestThreadId();
+  if (IsFrameThread(thread_id)) {
+    AddWait(g_frame_state, kind, object_type, guest_object, duration_ns);
+  }
+  if (g_scope_state.thread_id == thread_id) {
+    AddWait(g_scope_state, kind, object_type, guest_object, duration_ns);
+  }
+}
+
+void RecordGuestVblankPulse() {
+  if (GuestTimingTraceEnabled()) {
+    g_vblank_count.fetch_add(1, std::memory_order_relaxed);
+  }
+}
+
+void RecordGuestVdSwap() {
+  if (!GuestTimingTraceEnabled()) {
+    return;
+  }
+  const uint32_t thread_id = CurrentGuestThreadId();
+  if (IsFrameThread(thread_id) && g_frame_state.active) {
+    ++g_frame_state.vd_swap_calls;
+  }
+  if (g_scope_state.active && g_scope_state.thread_id == thread_id) {
+    ++g_scope_state.vd_swap_calls;
+  }
+}
+
+void RecordGuestTimebaseRead(uint32_t guest_pc) {
+  if (!GuestTimingTraceEnabled()) {
+    return;
+  }
+  const uint32_t thread_id = CurrentGuestThreadId();
+  if (IsFrameThread(thread_id)) {
+    AddTimebaseRead(g_frame_state, guest_pc);
+  }
+  if (g_scope_state.thread_id == thread_id) {
+    AddTimebaseRead(g_scope_state, guest_pc);
+  }
+}
+
+uint64_t QueryGuestTimebase(uint32_t guest_pc) {
+  RecordGuestTimebaseRead(guest_pc);
+  return chrono::Clock::QueryGuestTickCount();
+}
+
+}  // namespace rex::diagnostics
