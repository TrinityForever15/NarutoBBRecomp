diff --git a/include/rex/diagnostics/guest_timing.h b/include/rex/diagnostics/guest_timing.h
new file mode 100644
index 0000000..f66b8f5
--- /dev/null
+++ b/include/rex/diagnostics/guest_timing.h
@@ -0,0 +1,74 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::diagnostics {
+
+enum class GuestWaitKind : uint32_t {
+  kObject = 0,
+  kMultiple = 1,
+  kSignalAndWait = 2,
+  kDelay = 3,
+  kCount,
+};
+
+constexpr size_t kGuestWaitKindCount =
+    static_cast<size_t>(GuestWaitKind::kCount);
+constexpr size_t kMaxGuestTimeSourceSites = 32;
+
+struct GuestTimeSourceSite {
+  uint32_t guest_pc = 0;
+  uint32_t calls = 0;
+};
+
+struct GuestTimingSample {
+  bool valid = false;
+  uint64_t sequence = 0;
+  uint32_t scope_tag = 0;
+  uint32_t thread_id = 0;
+
+  uint64_t wall_ns = 0;
+  uint64_t cpu_ns = 0;
+  uint64_t blocked_ns = 0;
+  std::array<uint64_t, kGuestWaitKindCount> wait_ns{};
+  std::array<uint32_t, kGuestWaitKindCount> wait_calls{};
+
+  uint64_t longest_wait_ns = 0;
+  uint32_t longest_wait_object = 0;
+  uint32_t longest_wait_object_type = 0;
+  GuestWaitKind longest_wait_kind = GuestWaitKind::kObject;
+
+  uint32_t vblank_pulses = 0;
+  uint32_t vd_swap_calls = 0;
+  uint32_t timebase_reads = 0;
+  std::array<GuestTimeSourceSite, kMaxGuestTimeSourceSites>
+      time_source_sites{};
+  size_t time_source_site_count = 0;
+};
+
+void SetGuestTimingTraceEnabled(bool enabled);
+bool GuestTimingTraceEnabled();
+
+// Frame timing is associated with the first guest thread that calls Begin
+// after tracing is enabled. Calls from other guest threads are ignored.
+void BeginGuestFrameTiming(uint64_t sequence);
+GuestTimingSample EndGuestFrameTiming();
+
+// Scopes are thread-local and are useful for proving whether a particular
+// guest function is active or blocked internally.
+void BeginGuestTimingScope(uint32_t scope_tag);
+GuestTimingSample EndGuestTimingScope(uint32_t scope_tag);
+
+void RecordGuestWait(GuestWaitKind kind, uint32_t object_type,
+                     uint32_t guest_object, uint64_t duration_ns);
+void RecordGuestVblankPulse();
+void RecordGuestVdSwap();
+void RecordGuestTimebaseRead(uint32_t guest_pc);
+
+// Code generated for mftb/mftbu calls this wrapper so active time sources can
+// be attributed to their exact guest instruction without changing the XEX.
+uint64_t QueryGuestTimebase(uint32_t guest_pc);
+
+}  // namespace rex::diagnostics
