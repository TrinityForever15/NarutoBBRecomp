 namespace rex::audio::sdl {
 
+namespace {
+
+void ProtectOutputSamples(float* samples, size_t sample_count) {
+  constexpr float kKnee = 0.95f;
+  constexpr float kHeadroom = 1.0f - kKnee;
+  float input_peak = 0.0f;
+  uint32_t non_finite_count = 0;
+  uint32_t limited_count = 0;
+
+  for (size_t i = 0; i < sample_count; ++i) {
+    float sample = samples[i];
+    if (!std::isfinite(sample)) {
+      samples[i] = 0.0f;
+      ++non_finite_count;
+      continue;
+    }
+
+    const float magnitude = std::abs(sample);
+    input_peak = std::max(input_peak, magnitude);
+    if (magnitude > kKnee) {
+      // Continuous soft knee: y(0.95) = 0.95 and y approaches 1.0 without
+      // hard clipping, which avoids the strong crackle of effect transients.
+      const float limited_magnitude =
+          1.0f - kHeadroom /
+                     (1.0f + (magnitude - kKnee) / kHeadroom);
+      samples[i] = std::copysign(limited_magnitude, sample);
+      ++limited_count;
+    }
+  }
+
+  if (non_finite_count || input_peak > 1.05f) {
+    static std::atomic<uint64_t> last_peak_log_tick{0};
+    const uint64_t now_tick = rex::chrono::Clock::QueryHostTickCount();
+    const uint64_t tick_frequency =
+        rex::chrono::Clock::QueryHostTickFrequency();
+    uint64_t previous_tick =
+        last_peak_log_tick.load(std::memory_order_relaxed);
+    if ((!previous_tick || now_tick - previous_tick >= tick_frequency) &&
+        last_peak_log_tick.compare_exchange_strong(
+            previous_tick, now_tick, std::memory_order_relaxed)) {
+      REXAPU_WARN(
+          "NARUTO_AUDIO_PEAK peak={:.3f} limited_samples={} invalid_samples={}",
+          input_peak, limited_count, non_finite_count);
+    }
+  }
+}
+
+}  // namespace
+
