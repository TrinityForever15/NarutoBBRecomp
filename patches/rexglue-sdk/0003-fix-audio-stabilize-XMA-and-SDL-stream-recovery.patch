@@ -166,15 +230,47 @@ void SDLAudioDriver::SDLCallback(void* userdata, SDL_AudioStream* stream, int ad
     REXAPU_ERROR("SDLAudioDriver::SDLCallback failed to allocate {} samples", sample_count);
     return;
   }
+  const uint8_t channels = std::max<uint8_t>(driver->sdl_device_channels_, 1);
   while (additional_amount > 0) {
     static uint32_t sdl_callback_count = 0;
     std::unique_lock<std::mutex> guard(driver->frames_mutex_);
-    if (driver->frames_queued_.empty()) {
+    // After a gap, wait for a small cushion to rebuild before resuming. Handing
+    // out a single frame the instant one arrives guarantees the next callback
+    // underruns again, which is what turns one stall into a burst of clicks.
+    const bool starved =
+        driver->frames_queued_.empty() ||
+        (driver->in_underrun_ && driver->frames_queued_.size() < kRefillFrames);
+    if (starved) {
+      // Keep diagnostics out of the normal audio path. On underrun, emit at
+      // most one marker per second so a cutscene test can be correlated with
+      // visual stalls without flooding or materially affecting scheduling.
+      static std::atomic<uint64_t> last_underrun_log_tick{0};
+      const uint64_t now_tick = rex::chrono::Clock::QueryHostTickCount();
+      const uint64_t tick_frequency = rex::chrono::Clock::QueryHostTickFrequency();
+      uint64_t previous_tick = last_underrun_log_tick.load(std::memory_order_relaxed);
+      if ((!previous_tick || now_tick - previous_tick >= tick_frequency) &&
+          last_underrun_log_tick.compare_exchange_strong(
+              previous_tick, now_tick, std::memory_order_relaxed)) {
+        REXAPU_WARN("NARUTO_AUDIO_UNDERRUN requested_bytes={}", additional_amount);
+      }
       if (sdl_callback_count < 10) {
         REXAPU_DEBUG("SDLCallback: no frames queued (silence)");
         sdl_callback_count++;
       }
       std::memset(data, 0, len);
+      if (!driver->in_underrun_) {
+        // First silent chunk of this gap: ramp the last emitted sample down to
+        // zero instead of cutting it off, so the gap starts without a click.
+        const uint32_t fade =
+            std::min<uint32_t>(kConcealFadeSamples, static_cast<uint32_t>(channel_samples_));
+        for (uint32_t s = 0; s < fade; ++s) {
+          const float gain = 1.0f - (static_cast<float>(s) / static_cast<float>(fade));
+          for (uint8_t ch = 0; ch < channels; ++ch) {
+            data[s * channels + ch] = driver->last_samples_[ch] * gain;
+          }
+        }
+        driver->in_underrun_ = true;
+      }
       if (!SDL_PutAudioStreamData(stream, data, len)) {
         REXAPU_ERROR("SDL_PutAudioStreamData() failed while filling silence: {}", SDL_GetError());
         break;
@@ -188,7 +284,13 @@ void SDLAudioDriver::SDLCallback(void* userdata, SDL_AudioStream* stream, int ad
       } else {
         switch (driver->sdl_device_channels_) {
           case 2:
-            conversion::sequential_6_BE_to_interleaved_2_LE(data, buffer, channel_samples_);
+            if (REXCVAR_GET(audio_stereo_front_only)) {
+              conversion::sequential_6_BE_to_interleaved_2_front_LE(
+                  data, buffer, channel_samples_);
+            } else {
+              conversion::sequential_6_BE_to_interleaved_2_LE(
+                  data, buffer, channel_samples_);
+            }
             break;
           case 6:
             conversion::sequential_6_BE_to_interleaved_6_LE(data, buffer, channel_samples_);
@@ -197,7 +299,30 @@ void SDLAudioDriver::SDLCallback(void* userdata, SDL_AudioStream* stream, int ad
             assert_unhandled_case(driver->sdl_device_channels_);
             break;
         }
+        if (REXCVAR_GET(audio_output_limiter)) {
+          ProtectOutputSamples(data, sample_count);
+        }
       }
+
+      if (driver->in_underrun_) {
+        // First real chunk after a gap: ramp in from silence for the same
+        // reason we ramped out.
+        const uint32_t fade =
+            std::min<uint32_t>(kConcealFadeSamples, static_cast<uint32_t>(channel_samples_));
+        for (uint32_t s = 0; s < fade; ++s) {
+          const float gain = static_cast<float>(s) / static_cast<float>(fade);
+          for (uint8_t ch = 0; ch < channels; ++ch) {
+            data[s * channels + ch] *= gain;
+          }
+        }
+        driver->in_underrun_ = false;
+      }
+
+      // Remember the tail so the next gap can ramp out from it.
+      for (uint8_t ch = 0; ch < channels; ++ch) {
+        driver->last_samples_[ch] = data[(channel_samples_ - 1) * channels + ch];
+      }
+
       if (!SDL_PutAudioStreamData(stream, data, len)) {
         REXAPU_ERROR("SDL_PutAudioStreamData() failed: {}", SDL_GetError());
         driver->frames_unused_.push(buffer);
@@ -205,8 +330,16 @@ void SDLAudioDriver::SDLCallback(void* userdata, SDL_AudioStream* stream, int ad
       }
       driver->frames_unused_.push(buffer);
 
-      auto ret = driver->semaphore_->Release(1, nullptr);
-      assert_true(ret);
+      // Return the frame credit to the guest. If the semaphore is momentarily
+      // at its maximum count the release fails; dropping it permanently shrinks
+      // the client's frame budget, so the credit is carried over and retried.
+      uint32_t owed = driver->pending_releases_.exchange(0, std::memory_order_relaxed) + 1;
+      while (owed && driver->semaphore_->Release(1, nullptr)) {
+        --owed;
+      }
+      if (owed) {
+        driver->pending_releases_.fetch_add(owed, std::memory_order_relaxed);
+      }
       additional_amount -= len;
     }
   }
diff --git a/src/audio/xma_context.cpp b/src/audio/xma_context.cpp
index 451eb47..aa3aa59 100644
--- a/src/audio/xma_context.cpp
+++ b/src/audio/xma_context.cpp
@@ -178,6 +178,22 @@ void XmaContext::Clear() {
 }
 
 void XmaContext::ClearLocked(XMA_CONTEXT_DATA* data) {
+  // A context clear is used by the game when a stream is stopped, restarted
+  // or replaced (for example, after pausing or changing background music).
+  // FFmpeg retains codec delay and partially decoded packets across calls;
+  // leaving that state alive lets samples from the old stream bleed into the
+  // new one as hiss, crackle or a brief wrong music segment. The Xbox XMA
+  // hardware clear discards this state, so mirror that behavior here.
+  if (av_context_ && av_context_->codec) {
+    avcodec_flush_buffers(av_context_);
+  }
+  if (av_frame_) {
+    av_frame_unref(av_frame_);
+  }
+  if (av_packet_) {
+    av_packet_unref(av_packet_);
+  }
+
   data->input_buffer_0_valid = 0;
   data->input_buffer_1_valid = 0;
   data->output_buffer_valid = 0;
@@ -189,6 +205,8 @@ void XmaContext::ClearLocked(XMA_CONTEXT_DATA* data) {
   current_frame_remaining_subframes_ = 0;
   loop_frame_output_limit_ = 0;
   loop_start_skip_pending_ = false;
+  raw_frame_.fill(0);
+  xma_frame_.fill(0);
 }
 
