diff --git a/include/rex/audio/conversion.h b/include/rex/audio/conversion.h
index a9fa7bd..5c8063b 100644
--- a/include/rex/audio/conversion.h
+++ b/include/rex/audio/conversion.h
@@ -73,6 +73,38 @@ inline void sequential_6_BE_to_interleaved_2_LE(float* output, const float* inpu
     _mm_storeu_ps(&output[(sample + 2) * 2], _mm_unpackhi_ps(left, right));
