+
+// Some Xbox 360 titles leave content in the surround buses that isn't meant
+// to be folded into a stereo endpoint. Keep the front soundstage intact and
+// add the center channel at -3 dB, with normalization to prevent clipping.
+inline void sequential_6_BE_to_interleaved_2_front_LE(
+    float* output, const float* input, size_t ch_sample_count) {
+  assert_true(ch_sample_count % 4 == 0);
+
+  const __m128i byte_swap_shuffle =
+      _mm_set_epi8(12, 13, 14, 15, 8, 9, 10, 11, 4, 5, 6, 7, 0, 1, 2, 3);
+  const __m128 center_gain = _mm_set1_ps(0.7071067812f);
+  const __m128 normalize = _mm_set1_ps(0.5857864376f);
+
+  for (size_t sample = 0; sample < ch_sample_count; sample += 4) {
+    __m128 fl = _mm_loadu_ps(&input[0 * ch_sample_count + sample]);
+    __m128 fr = _mm_loadu_ps(&input[1 * ch_sample_count + sample]);
+    __m128 fc = _mm_loadu_ps(&input[2 * ch_sample_count + sample]);
+    fl = _mm_castsi128_ps(
+        _mm_shuffle_epi8(_mm_castps_si128(fl), byte_swap_shuffle));
+    fr = _mm_castsi128_ps(
+        _mm_shuffle_epi8(_mm_castps_si128(fr), byte_swap_shuffle));
+    fc = _mm_castsi128_ps(
+        _mm_shuffle_epi8(_mm_castps_si128(fc), byte_swap_shuffle));
+
+    const __m128 center = _mm_mul_ps(fc, center_gain);
+    const __m128 left = _mm_mul_ps(_mm_add_ps(fl, center), normalize);
+    const __m128 right = _mm_mul_ps(_mm_add_ps(fr, center), normalize);
+    _mm_storeu_ps(&output[sample * 2], _mm_unpacklo_ps(left, right));
+    _mm_storeu_ps(&output[(sample + 2) * 2],
+                  _mm_unpackhi_ps(left, right));
+  }
+}
 #else
 inline void sequential_6_BE_to_interleaved_6_LE(float* output, const float* input,
                                                 size_t ch_sample_count) {
@@ -98,6 +130,18 @@ inline void sequential_6_BE_to_interleaved_2_LE(float* output, const float* inpu
     output[sample * 2 + 1] = (fr + br + center_halved) * (1.0f / 2.5f);
   }
 }
+inline void sequential_6_BE_to_interleaved_2_front_LE(
+    float* output, const float* input, size_t ch_sample_count) {
+  constexpr float center_gain = 0.7071067812f;
+  constexpr float normalize = 0.5857864376f;
+  for (size_t sample = 0; sample < ch_sample_count; sample++) {
+    const float fl = rex::byte_swap(input[0 * ch_sample_count + sample]);
+    const float fr = rex::byte_swap(input[1 * ch_sample_count + sample]);
+    const float fc = rex::byte_swap(input[2 * ch_sample_count + sample]);
+    output[sample * 2] = (fl + fc * center_gain) * normalize;
+    output[sample * 2 + 1] = (fr + fc * center_gain) * normalize;
+  }
+}
 #endif
 
 }  // namespace rex::audio::conversion
diff --git a/include/rex/audio/sdl/sdl_audio_driver.h b/include/rex/audio/sdl/sdl_audio_driver.h
index f8949ca..6947790 100644
--- a/include/rex/audio/sdl/sdl_audio_driver.h
+++ b/include/rex/audio/sdl/sdl_audio_driver.h
@@ -11,6 +11,8 @@
 
 #pragma once
 
+#include <array>
+#include <atomic>
 #include <mutex>
 #include <queue>
 #include <stack>
@@ -49,6 +51,28 @@ class SDLAudioDriver : public AudioDriver {
   std::queue<float*> frames_queued_ = {};
   std::stack<float*> frames_unused_ = {};
   std::mutex frames_mutex_ = {};
+
+  // Underrun concealment. Hard-cutting to zero (and back) at a frame boundary
+  // is a step discontinuity in the waveform, which is exactly what is heard as
+  // a click/crackle. We instead ramp out from the last emitted sample and ramp
+  // back in on the first frame that follows the gap.
+  static const uint32_t kConcealFadeSamples = 64;  // ~1.3 ms at 48 kHz
+  std::array<float, frame_channels_> last_samples_ = {};
+  // Start in refill mode too: do not send the first partially produced XMA
+  // frame straight to the device, as that creates the same startup crackle as
+  // an in-game underrun.
+  bool in_underrun_ = true;
+
+  // Credits owed to the guest that Semaphore::Release refused (the semaphore
+  // was already at its maximum count). Dropping them silently leaks the
+  // client's frame budget and starves audio permanently; we retry instead.
+  std::atomic<uint32_t> pending_releases_ = {0};
+
+  // Number of frames that must be queued before playback begins or resumes.
+  // Four frames (~21 ms) were not enough for Naruto's bursty XMA production:
+  // the device immediately starved again during scene changes. Sixteen frames
+  // provide an ~85 ms cushion while staying well below the 341 ms queue cap.
+  static const uint32_t kRefillFrames = 16;
 };
 
 }  // namespace rex::audio::sdl
