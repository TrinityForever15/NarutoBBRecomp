+namespace {
+
+class HighResolutionSleepTimer {
+ public:
+  HighResolutionSleepTimer()
+      : handle_(CreateWaitableTimerExW(
+            nullptr, nullptr,
+            0x00000002,  // CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+            TIMER_MODIFY_STATE | SYNCHRONIZE)) {}
+
+  ~HighResolutionSleepTimer() {
+    if (handle_) {
+      CloseHandle(handle_);
+    }
+  }
+
+  HANDLE handle() const { return handle_; }
+
+ private:
+  HANDLE handle_ = nullptr;
+};
+
+}  // namespace
+
+void SleepHighResolution(std::chrono::microseconds duration) {
+  if (duration.count() < 100) {
+    MaybeYield();
+    return;
+  }
+
+  static thread_local HighResolutionSleepTimer timer;
+  if (!timer.handle()) {
+    Sleep(duration);
+    return;
+  }
+
+  LARGE_INTEGER due_time;
+  due_time.QuadPart = -duration.count() * 10;
+  if (!SetWaitableTimerEx(timer.handle(), &due_time, 0, nullptr, nullptr,
+                          nullptr, 0) ||
+      WaitForSingleObject(timer.handle(), INFINITE) != WAIT_OBJECT_0) {
+    Sleep(duration);
+  }
+}
+
 SleepResult AlertableSleep(std::chrono::microseconds duration) {
   if (SleepEx(static_cast<DWORD>(duration.count() / 1000), TRUE) == WAIT_IO_COMPLETION) {
     return SleepResult::kAlerted;
