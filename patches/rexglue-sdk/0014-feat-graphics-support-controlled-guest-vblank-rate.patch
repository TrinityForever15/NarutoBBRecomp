+          }
           if (REXCVAR_GET(vsync) && REXCVAR_GET(precise_vblank)) {
             if (current_time >= next_frame_time) {
               // A real display doesn't deliver several old vertical blanks at
@@ -189,6 +207,10 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
               const uint64_t completed_time = chrono::Clock::QueryGuestTickCount();
               const uint64_t elapsed_intervals =
                   (completed_time - next_frame_time) / vsync_interval_ticks + 1;
+              if (elapsed_intervals > 1) {
+                diagnostics::RecordGuestVblankCoalescedIntervals(
+                    elapsed_intervals - 1);
