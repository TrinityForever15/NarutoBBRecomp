   Sleep(std::chrono::duration_cast<std::chrono::microseconds>(duration));
 }
 
+// Sleeps using the most precise host timer available. This is intended for
+// sub-frame scheduling where the platform's ordinary sleep granularity may be
+// longer than the requested duration. Falls back to Sleep when a high-
+// resolution timer is unavailable.
+void SleepHighResolution(std::chrono::microseconds duration);
+template <typename Rep, typename Period>
+void SleepHighResolution(std::chrono::duration<Rep, Period> duration) {
+  SleepHighResolution(
+      std::chrono::duration_cast<std::chrono::microseconds>(duration));
+}
