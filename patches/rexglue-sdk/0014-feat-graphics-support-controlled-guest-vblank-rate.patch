+void UpdateAtomicMax(std::atomic<uint64_t>& target, uint64_t value) {
+  uint64_t current = target.load(std::memory_order_relaxed);
+  while (current < value &&
+         !target.compare_exchange_weak(current, value,
+                                       std::memory_order_relaxed)) {
+  }
+}
+
+void ResetGuestVblankWorkerTiming() {
+  g_vblank_worker_samples.store(0, std::memory_order_relaxed);
+  g_vblank_worker_total_ns.store(0, std::memory_order_relaxed);
+  g_vblank_worker_interrupt_ns.store(0, std::memory_order_relaxed);
+  g_vblank_worker_max_total_ns.store(0, std::memory_order_relaxed);
+  g_vblank_worker_max_interrupt_ns.store(0, std::memory_order_relaxed);
+  g_vblank_worker_coalesced_intervals.store(0,
+                                             std::memory_order_relaxed);
+}
+
 void AddTimebaseRead(TimingState& state, uint32_t guest_pc) {
   if (!state.active) {
     return;
@@ -189,6 +214,7 @@ bool IsFrameThread(uint32_t thread_id) {
 }  // namespace
 
 void SetGuestTimingTraceEnabled(bool enabled) {
+  ResetGuestVblankWorkerTiming();
   g_enabled.store(enabled, std::memory_order_release);
   if (!enabled) {
     g_frame_state.active = false;
@@ -276,6 +302,56 @@ uint64_t GuestVblankPulseCount() {
   return g_vblank_count.load(std::memory_order_relaxed);
 }
 
+void SetGuestVblankRateMultiplier(uint32_t multiplier) {
+  g_vblank_rate_multiplier.store(std::clamp(multiplier, 1u, 4u),
+                                 std::memory_order_release);
+}
+
+uint32_t GuestVblankRateMultiplier() {
+  return g_vblank_rate_multiplier.load(std::memory_order_acquire);
+}
+
+void RecordGuestVblankWorkerTiming(uint64_t total_ns,
+                                   uint64_t interrupt_ns) {
+  if (!GuestTimingTraceEnabled()) {
+    return;
+  }
+  g_vblank_worker_samples.fetch_add(1, std::memory_order_relaxed);
+  g_vblank_worker_total_ns.fetch_add(total_ns, std::memory_order_relaxed);
+  g_vblank_worker_interrupt_ns.fetch_add(interrupt_ns,
+                                         std::memory_order_relaxed);
+  UpdateAtomicMax(g_vblank_worker_max_total_ns, total_ns);
+  UpdateAtomicMax(g_vblank_worker_max_interrupt_ns, interrupt_ns);
+}
+
+void RecordGuestVblankCoalescedIntervals(uint64_t intervals) {
+  if (GuestTimingTraceEnabled()) {
+    g_vblank_worker_coalesced_intervals.fetch_add(
+        intervals, std::memory_order_relaxed);
+  }
+}
+
+GuestVblankWorkerTiming ConsumeGuestVblankWorkerTiming() {
+  return {
+      .samples =
+          g_vblank_worker_samples.exchange(0, std::memory_order_relaxed),
+      .total_ns =
+          g_vblank_worker_total_ns.exchange(0, std::memory_order_relaxed),
+      .interrupt_ns =
+          g_vblank_worker_interrupt_ns.exchange(0,
+                                                 std::memory_order_relaxed),
+      .max_total_ns =
+          g_vblank_worker_max_total_ns.exchange(0,
+                                                 std::memory_order_relaxed),
+      .max_interrupt_ns =
+          g_vblank_worker_max_interrupt_ns.exchange(
+              0, std::memory_order_relaxed),
+      .coalesced_intervals =
+          g_vblank_worker_coalesced_intervals.exchange(
+              0, std::memory_order_relaxed),
+  };
+}
