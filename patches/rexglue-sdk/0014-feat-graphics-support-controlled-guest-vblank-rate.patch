             }
@@ -198,7 +220,17 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
               const uint64_t sleep_ticks = remaining_ticks - precision_guard_ticks;
               const uint64_t sleep_microseconds =
