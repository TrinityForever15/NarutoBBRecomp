+std::atomic<uint64_t> g_vblank_worker_total_ns{0};
+std::atomic<uint64_t> g_vblank_worker_interrupt_ns{0};
+std::atomic<uint64_t> g_vblank_worker_max_total_ns{0};
+std::atomic<uint64_t> g_vblank_worker_max_interrupt_ns{0};
