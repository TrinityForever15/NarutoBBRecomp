@@ -173,6 +179,18 @@ X_STATUS GraphicsSystem::SetupGuestGpu(runtime::FunctionDispatcher* function_dis
             std::max(uint64_t(1), guest_tick_frequency / 2000);  // 0.5 ms.
         while (vsync_worker_running_) {
           uint64_t current_time = chrono::Clock::QueryGuestTickCount();
+          const uint32_t requested_vblank_rate_multiplier =
