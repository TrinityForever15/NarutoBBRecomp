diff --git a/include/rex/audio/xma/context.h b/include/rex/audio/xma/context.h
index f6d5975..9fd20d8 100644
--- a/include/rex/audio/xma/context.h
+++ b/include/rex/audio/xma/context.h
@@ -217,6 +217,73 @@ class XmaContext {
   }
   void set_is_enabled(bool is_enabled) { is_enabled_.store(is_enabled, std::memory_order_release); }
 
+  // Continuity telemetry for one stream. Every field is accumulated inside
+  // Work() on the decoder worker thread and drained by that same thread, so
+  // this never touches the real-time audio callback.
+  struct Telemetry {
+    uint64_t decoded_frames = 0;
+    uint64_t decode_errors = 0;
+    // The two places that raise error_status 4 are distinguished, because they
+    // mean different things. A split frame header that reads as the maximum
+    // length is malformed input. A missing next packet may simply mean the
+    // guest has not supplied the following buffer yet, which is a temporary
+    // condition rather than a stream error.
+    uint64_t err_header_split = 0;
+    uint64_t err_next_packet = 0;
+    // Subset of err_next_packet where no other input buffer was valid either,
+    // so there was genuinely nothing more to read at that moment.
+    uint64_t err_next_packet_starved = 0;
+    // Times that starved case was treated as a stall instead of a stream error.
+    uint64_t stalls_waiting_for_input = 0;
+    // Stalls that exceeded the wait budget and fell back to the stream error.
+    // A stream that genuinely ended mid-frame reaches this and terminates,
+    // instead of waiting forever for a buffer the guest will never supply.
+    uint64_t stall_timeouts = 0;
+
+    // How stalls that did NOT time out ended, and how long they took. If the
+    // typical wait is short, the timeout only ends genuinely finished streams.
+    // If waits are spread up to the timeout, the guest is chronically late and
+    // the timeout is cutting live streams.
+    uint64_t stall_resolved = 0;
+    uint64_t stall_resolved_by_swap = 0;
+    uint64_t stall_us_sum = 0;
+    uint64_t stall_us_max = 0;
+    uint64_t stall_fast = 0;    // under 5 ms
+    uint64_t stall_medium = 0;  // 5 to 30 ms
+    uint64_t stall_slow = 0;    // 30 ms and above
+
+    // The guest can write the read offset itself, and StoreContextMerged
+    // preserves guest writes. Detecting that separates "we moved the stream
+    // backwards" from "the title rewound its own stream", which are opposite
+    // conclusions for the repeated-fragment symptom.
+    uint64_t guest_offset_changes = 0;
+    uint64_t guest_offset_rewinds = 0;
+    // Consumed buffers released so the guest could supply the continuation of
+    // a split frame, instead of holding the buffer and deadlocking.
+    uint64_t split_releases = 0;
+    uint64_t buffer_swaps = 0;
+    uint64_t loop_resets = 0;
+    // Decodes that started from an input offset already covered since the last
+    // buffer swap. A stream repeating a section reports this while its decode
+    // rate still looks healthy, which separates repetition from starvation.
+    uint64_t offset_repeats = 0;
+    uint32_t sample_rate = 0;
+    uint32_t input_valid = 0;
+
+    bool HasActivity() const {
+      return decoded_frames || decode_errors || buffer_swaps || loop_resets ||
+             offset_repeats || err_next_packet || guest_offset_changes ||
+             split_releases;
+    }
+  };
+
+  // Returns the counters accumulated since the previous call and resets them.
+  Telemetry DrainTelemetry() {
+    Telemetry drained = telemetry_;
+    telemetry_ = Telemetry{};
+    return drained;
+  }
+
   void SignalWorkDone() {
     if (work_completion_event_) {
       work_completion_event_->Set();
@@ -229,7 +296,9 @@ class XmaContext {
   }
 
  private:
-  static void SwapInputBuffer(XMA_CONTEXT_DATA* data);
+  // Not static: swapping is the event that proves the guest is still feeding
+  // this stream, so it is counted here rather than at six call sites.
+  void SwapInputBuffer(XMA_CONTEXT_DATA* data);
   static int GetSampleRate(int id);
   static int16_t GetPacketNumber(size_t size, size_t bit_offset);
   static uint32_t GetCurrentInputBufferSize(XMA_CONTEXT_DATA* data);
@@ -290,6 +359,20 @@ class XmaContext {
   // Loop subframe precision state
   uint8_t loop_frame_output_limit_ = 0;
   bool loop_start_skip_pending_ = false;
+
+  Telemetry telemetry_;
+  // Host tick when the current uninterrupted stall began, or zero when the
+  // stream is progressing. Cleared by a successful decode and by a buffer swap.
+  uint64_t stall_since_tick_ = 0;
+  // Records how a stall ended, before clearing the timestamp.
+  void EndStall(bool by_swap);
+  // Read offset this context last wrote back to guest memory, used to notice
+  // when the value changed underneath us before the next Work().
+  uint32_t last_stored_read_offset_ = 0;
+  bool has_stored_read_offset_ = false;
+  // Highest input offset decoded since the last buffer swap. A decode starting
+  // below it means the stream went backwards without being refilled.
+  uint32_t telemetry_max_offset_since_swap_ = 0;
 };
 
 }  // namespace rex::audio
