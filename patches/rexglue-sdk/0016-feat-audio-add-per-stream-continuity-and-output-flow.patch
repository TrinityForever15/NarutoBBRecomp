 void SDLAudioDriver::LogInputDiagnosticsSummary() {
   if (!REXCVAR_GET(audio_silence_diagnostics) || !diagnostic_frame_count_) {
     return;
@@ -294,6 +325,17 @@ void SDLAudioDriver::SDLCallback(void* userdata, SDL_AudioStream* stream, int ad
     // underruns again, which is what turns one stall into a burst of clicks.
     const bool starved = driver->frames_queued_.empty() ||
                          (driver->in_underrun_ && driver->frames_queued_.size() < kRefillFrames);
+
+    // Counter-only flow sampling. This runs under frames_mutex_, which the
+    // callback already holds here.
+    ++driver->flow_telemetry_.callbacks;
+    const uint32_t queued_now = static_cast<uint32_t>(driver->frames_queued_.size());
+    driver->flow_telemetry_.queued_sum += queued_now;
+    driver->flow_telemetry_.queued_min = std::min(driver->flow_telemetry_.queued_min, queued_now);
+    if (starved) {
+      ++driver->flow_telemetry_.underrun_chunks;
+    }
+
     if (starved) {
       // Keep diagnostics out of the normal audio path. On underrun, emit at
       // most one marker per second so a cutscene test can be correlated with
@@ -357,6 +399,22 @@ void SDLAudioDriver::SDLCallback(void* userdata, SDL_AudioStream* stream, int ad
         }
       }
 
+      // Measure the seam before the ramp-in smooths it, so the counter sees
+      // the discontinuity the concealment is there to hide rather than the
+      // concealed result. Arithmetic only: no formatting, no allocation.
+      if (!driver->in_underrun_) {
+        float worst_step = 0.0f;
+        for (uint8_t ch = 0; ch < channels; ++ch) {
+          const float step = std::abs(data[ch] - driver->last_samples_[ch]);
+          worst_step = std::max(worst_step, step);
+        }
+        if (worst_step > kDiscontinuityThreshold) {
+          ++driver->flow_telemetry_.discontinuity_events;
+        }
+        driver->flow_telemetry_.max_discontinuity =
+            std::max(driver->flow_telemetry_.max_discontinuity, worst_step);
+      }
+
       if (driver->in_underrun_) {
         // First real chunk after a gap: ramp in from silence for the same
         // reason we ramped out.
