+        AudioDriver* drivers[kMaximumClientCount] = {};
+        size_t driver_count = 0;
+        {
+          auto telemetry_lock = global_critical_region_.Acquire();
+          for (size_t i = 0; i < kMaximumClientCount; ++i) {
