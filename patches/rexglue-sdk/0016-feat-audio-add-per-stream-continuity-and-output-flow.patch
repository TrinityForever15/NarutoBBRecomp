   static const uint32_t kConcealFadeSamples = 64;  // ~1.3 ms at 48 kHz
   std::array<float, frame_channels_> last_samples_ = {};
+
+  // A step this large between two adjacent samples is not musical content at
+  // 48 kHz; it is the waveform discontinuity that is heard as a click.
+  static constexpr float kDiscontinuityThreshold = 0.25f;
+  // Guarded by frames_mutex_, which the callback already holds where these are
+  // incremented.
+  FlowTelemetry flow_telemetry_ = {};
