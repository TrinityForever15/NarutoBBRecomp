+void SDLAudioDriver::ReportFlowTelemetry() {
+  if (!REXCVAR_GET(naruto_audio_flow_telemetry)) {
+    return;
+  }
+  const FlowTelemetry flow = DrainFlowTelemetry();
+  if (flow.callbacks == 0) {
+    return;
+  }
+  constexpr double kChunkMs = 1000.0 * static_cast<double>(channel_samples_) / frame_frequency_;
+  REXAPU_INFO(
+      "NARUTO_AUDIO_FLOW callbacks={} queued_avg={:.2f} queued_min={} "
+      "underrun_chunks={} underrun_ms={:.1f} discontinuity_events={} "
+      "max_discontinuity={:.3f}",
+      flow.callbacks, static_cast<double>(flow.queued_sum) / static_cast<double>(flow.callbacks),
+      flow.queued_min == 0xFFFFFFFF ? 0 : flow.queued_min, flow.underrun_chunks,
+      static_cast<double>(flow.underrun_chunks) * kChunkMs, flow.discontinuity_events,
+      flow.max_discontinuity);
+}
+
+SDLAudioDriver::FlowTelemetry SDLAudioDriver::DrainFlowTelemetry() {
+  std::lock_guard<std::mutex> guard(frames_mutex_);
+  FlowTelemetry drained = flow_telemetry_;
+  flow_telemetry_ = FlowTelemetry{};
+  return drained;
+}
