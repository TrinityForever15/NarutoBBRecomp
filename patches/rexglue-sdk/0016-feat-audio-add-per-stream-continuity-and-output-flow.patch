+
+void XmaContext::EndStall(bool by_swap) {
+  if (stall_since_tick_ == 0) {
+    return;
+  }
+  const uint64_t elapsed_us =
+      (rex::chrono::Clock::QueryHostTickCount() - stall_since_tick_) * 1000000ull /
+      std::max<uint64_t>(1, rex::chrono::Clock::QueryHostTickFrequency());
+  stall_since_tick_ = 0;
+
+  ++telemetry_.stall_resolved;
+  if (by_swap) {
+    ++telemetry_.stall_resolved_by_swap;
+  }
+  telemetry_.stall_us_sum += elapsed_us;
+  telemetry_.stall_us_max = std::max(telemetry_.stall_us_max, elapsed_us);
+  if (elapsed_us < 5000) {
+    ++telemetry_.stall_fast;
+  } else if (elapsed_us < 30000) {
+    ++telemetry_.stall_medium;
+  } else {
+    ++telemetry_.stall_slow;
+  }
 }
 
