-        contexts_[context_id].WaitForWorkDone();
+    if (dedicated_thread_enabled_) {
+      // Signal the decoder thread to start processing.
+      work_event_->Set();
+      // Block until the worker finishes, so the game sees updated context data.
+      for (int i = 0; kicked_value && i < 32; ++i, kicked_value >>= 1) {
+        if (kicked_value & 1) {
+          uint32_t context_id = base_context_id + i;
+          contexts_[context_id].WaitForWorkDone();
+        }
+      }
+    } else {
+      // Match Xenia's per-title workaround: perform kicked contexts on the
+      // caller so guest-visible context state is updated deterministically.
+      for (int i = 0; kicked_value && i < 32; ++i, kicked_value >>= 1) {
+        if (kicked_value & 1) {
+          uint32_t context_id = base_context_id + i;
+          if (contexts_[context_id].Work()) {
+            PROFILE_XMA_FRAME_DECODED();
+          }
+        }
       }
     }
   } else if (r >= XmaRegister::Context0Lock && r <= XmaRegister::Context9Lock) {
@@ -357,6 +377,10 @@ void XmaDecoder::Pause() {
